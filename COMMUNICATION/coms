cmd_listen() {
  local agent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="${2:-}"; shift 2 ;;
      *) agent="$1"; shift ;;
    esac
  done
  agent="${agent:-${COMS_AGENT:-}}"
  if [[ -z "$agent" ]]; then
    echo "usage: COMS listen --agent <role>" >&2
    return 2
  fi
  identity "$agent"
  echo "listening ${INBOX}  (Ctrl-C to stop)"
  # A bare `mosquitto_sub` exits on any broker restart or LAN blip, and a dead
  # listener is indistinguishable from "no messages" — the agent goes deaf with
  # no error surfaced. Supervise it and reconnect instead.
  trap 'echo "listener stopped"; exit 0' INT TERM
  trap '' PIPE
  while true; do
    mosquitto_sub -h "$BROKER" -p "$PORT" -v \
      -t "${INBOX}" \
      -t "inbox/${HOST}/${WT}/all" \
      -t "mentions/all" || true
    echo "listener dropped (broker restart or network) — reconnecting in 5s" >&2
    sleep 5
  done
}

cmd_check() {
  # Non-blocking inbox read: what is on my topics right now, retained plus
  # anything already in flight. This is the verb three separate agents asked for
  # and never got; `listen` alone cannot answer "what arrived while I was away?".
  local agent="" wait_s=3 notes=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="${2:-}"; shift 2 ;;
      --wait) wait_s="${2:-3}"; shift 2 ;;
      --no-notes) notes=0; shift ;;
      *) agent="$1"; shift ;;
    esac
  done
  # `--wait abc` used to reach arithmetic and die with an unbound-variable error;
  # validate so the failure is a clean usage message instead of a stack trace.
  if ! [[ "$wait_s" =~ ^[0-9]+$ ]]; then
    echo "usage: COMS check --agent <role> [--wait <seconds>]  (--wait must be a non-negative integer)" >&2
    return 2
  fi
  agent="${agent:-${COMS_AGENT:-}}"
  if [[ -z "$agent" ]]; then
    echo "usage: COMS check --agent <role> [--wait <seconds>]" >&2
    return 2
  fi
  identity "$agent"
  echo "checking ${INBOX} ${wait_s}s window"
  local tmp
  tmp="$(mktemp)"
  # Do NOT pass --no-retained: retained messages are the only thing that
  # survives while your listener is down, and they are delivered on subscribe.
  timeout $((wait_s + 2)) mosquitto_sub -h "$BROKER" -p "$PORT" -v -W "$wait_s" \
    -t "${INBOX}" \
    -t "inbox/${HOST}/${WT}/all" \
    -t "mentions/all" > "$tmp" 2>/dev/null || true
  local n
  n="$(sort -u "$tmp" | sed '/^$/d' | wc -l | tr -d ' ')"
  sort -u "$tmp" | sed '/^$/d'
  rm -f "$tmp"
  if [[ "$n" -eq 0 ]]; then
    echo "no messages on ${INBOX}, inbox/${HOST}/${WT}/all, mentions/all"
  else
    echo "--- ${n} message(s)"
  fi

  # notes/* carry FULL DOCUMENTS (one was 20,954 B) and are not any of the three
  # topics above, so they were invisible to every `check` -- an agent could
  # honestly report "no messages" while 40+ notes were live. Do not dump the
  # payloads (that would bury the inbox output); list topic + size so the caller
  # knows they exist and can read one deliberately. Skip with --no-notes.
  if [[ "$notes" -eq 1 ]]; then
    local ntmp ncount
    ntmp="$(mktemp)"
    timeout 5 mosquitto_sub -h "$BROKER" -p "$PORT" -F '%t|%l' -W 3 -t 'notes/#' >"$ntmp" 2>/dev/null || true
    ncount="$(sort -u "$ntmp" | sed '/^$/d' | wc -l | tr -d ' ')"
    if [[ "$ncount" -gt 0 ]]; then
      echo "--- ${ncount} note(s) on notes/# (payloads NOT shown — read one with:)"
      echo "      mosquitto_sub -h ${BROKER} -t 'notes/<slug>' -W 2"
      sort -u "$ntmp" | sed '/^$/d' | awk -F'|' '{printf "    %-66s %7s B\n", $1, $2}'
    fi
    rm -f "$ntmp"
  fi
  return 0
}

cmd_topics() {
  # Full bus inventory: every topic with its payload size, plus a per-prefix
  # roll-up. `check` covers your inbox; this answers "what else is out there?"
  # Added because the bus carries ~130 topics while check read 3.
  local wait_s=6 pat="#"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) wait_s="${2:-6}"; shift 2 ;;
      *) pat="$1"; shift ;;
    esac
  done
  if ! [[ "$wait_s" =~ ^[0-9]+$ ]]; then
    echo "usage: COMS topics [<pattern>] [--wait <seconds>]" >&2
    return 2
  fi
  case "$pat" in
    *\**)
      echo "ERROR: '*' is not an MQTT wildcard. Use '+' for one level or '#' for the subtree (e.g. notes/+ or notes/#)." >&2
      return 2
      ;;
  esac
  local tmp rows total
  tmp="$(mktemp)"
  timeout $((wait_s + 2)) mosquitto_sub -h "$BROKER" -p "$PORT" -F '%t|%l' -W "$wait_s" -t "$pat" >"$tmp" 2>/dev/null || true
  rows="$(sort -u "$tmp" | sed '/^$/d')"
  rm -f "$tmp"
  total="$(printf '%s\n' "$rows" | sed '/^$/d' | wc -l | tr -d ' ')"
  if [[ "$total" -eq 0 ]]; then
    echo "no retained/in-flight topics matching '${pat}' in ${wait_s}s"
    return 0
  fi
  echo "${total} topic(s) matching '${pat}' on ${BROKER}:${PORT}"
  printf '%s\n' "$rows" | awk -F'|' '
    { p=$1; sub(/\/.*/,"",p); n[p]++; b[p]+=$2+0 }
    END { for (k in n) printf "  %-12s %4d topic(s) %9d B\n", k, n[k], b[k] }
  ' | sort
  echo
  printf '%s\n' "$rows" | awk -F'|' '{ printf "  %-70s %8s B\n", $1, ($2+0>0 ? $2 : "empty") }'
  return 0
}

refuse_secrets() {
  python3 -c '
import sys, re
text = sys.stdin.read()
pats = [
  (r"-----BEGIN [A-Z ]*PRIVATE KEY-----", "private-key"),
  (r"\bAKIA[0-9A-Z]{16}\b", "aws-key"),
  (r"\bsk-[A-Za-z0-9]{20,}", "sk-token"),
  (r"\bgh[pousr]_[A-Za-z0-9]{20,}", "github-token"),
  (r"\bxox[baprs]-[A-Za-z0-9-]{10,}", "slack-token"),
  (r"(?i)(?<![?&])(api[_-]?key|secret|password|passwd|token)\s*[:=]\s*\S{8,}", "assigned-secret"),
]
hits = [name for pat, name in pats if re.search(pat, text)]
if hits:
    print("refusing secret-like content: " + ",".join(hits), file=sys.stderr)
    print("do not publish or commit this. Git and MQTT are both shared.", file=sys.stderr)
    sys.exit(2)
'
}

cmd_guard() {
  if [[ $# -eq 0 ]]; then
    refuse_secrets || return 2
    echo "clean"
    return 0
  fi
  local f hit=0
  for f in "$@"; do
    if [[ -f "$f" ]] && ! refuse_secrets <"$f"; then
      echo "blocked $f" >&2
      hit=1
    fi
  done
  [[ $hit -eq 0 ]] && echo "clean"
  return $hit
}

resolve_topic() {
  # slug() rewrites dots, so a folder named findtorontoevents_antigravity.ca
  # becomes findtorontoevents_antigravity-ca. If a sender passes the literal
  # folder name, the subscriber (which slugs) never hears it. Resolve the
  # host/worktree segments of inbox topics so "sent" matches what is subscribed.
  local t="$1"
  if [[ "$t" =~ ^inbox/([^/]+)/([^/]+)/(.+)$ ]]; then
    printf 'inbox/%s/%s/%s' "$(slug "${BASH_REMATCH[1]}")" "$(slug "${BASH_REMATCH[2]}")" "${BASH_REMATCH[3]}"
  else
    printf '%s' "$t"
  fi
}

cmd_send() {
  local topic="" msg="" retain=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --retain|-r) retain=1; shift ;;
      *) if [[ -z "$topic" ]]; then topic="$1"; elif [[ -z "$msg" ]]; then msg="$1"; else msg="$msg $1"; fi; shift ;;
    esac
  done
  if [[ -z "$topic" || -z "$msg" ]]; then
    echo "usage: COMS send [--retain] <topic> <message>" >&2
    return 2
  fi
  printf '%s' "$msg" | refuse_secrets || return 2
  local resolved
  resolved="$(resolve_topic "$topic")"
  local args=(-q 1)
  [[ $retain -eq 1 ]] && args+=(-r)
  if ! mosquitto_pub -h "$BROKER" -p "$PORT" "${args[@]}" -t "$resolved" -m "$msg" 2>/dev/null; then
    echo "ERROR: publish to ${resolved} failed (broker ${BROKER}:${PORT} unreachable?) — message NOT sent" >&2
    return 1
  fi
  if [[ "$resolved" != "$topic" ]]; then
    echo "note: resolved topic ${topic} -> ${resolved} (slug rewrites dots)"
  fi
  if [[ $retain -eq 1 ]]; then
    echo "sent ${resolved} (qos1, retained — a later COMS check will receive it)"
  else
    echo "sent ${resolved} (qos1, not retained — no delivery guarantee; verify with: COMS check --agent <role>)"
  fi
  return 0
}

cmd_unregister() {
  # B8: registry/# is retained and never cleared, and ~/.coms/agents.jsonl is
  # append-only, so dead seats accumulate forever. Publishing an empty retained
  # payload clears the broker copy; the local row is dropped by inbox match.
  local agent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="${2:-}"; shift 2 ;;
      *) agent="$1"; shift ;;
    esac
  done
  agent="${agent:-${COMS_AGENT:-}}"
  if [[ -z "$agent" ]]; then
    echo "usage: COMS unregister --agent <role>" >&2
    return 2
  fi
  identity "$agent"
  mosquitto_pub -h "$BROKER" -p "$PORT" -q 1 -r -t "registry/${HOST}/${WT}/${AGENT}" -m ''
  if [[ -f "$LOCAL_REG" ]]; then
    python3 - "$LOCAL_REG" "$INBOX" <<'PY'
import sys
from pathlib import Path
p, inbox = Path(sys.argv[1]), sys.argv[2]
if p.is_file():
    keep = [l for l in p.read_text(encoding="utf-8", errors="replace").splitlines()
            if l.strip() and f'"{inbox}"' not in l]
    p.write_text("\n".join(keep) + ("\n" if keep else ""), encoding="utf-8")
PY
  fi
  echo "unregistered ${INBOX}"
}

menu() {
  cat <<EOF
COMS_MENU  broker ${BROKER}:${PORT}
  1 learn     why, broker, github, inbox rule
  2 status    is the broker up
  3 roster    registered agents, folders, repos
  4 register  COMS register --agent <role>   (run inside that agent's folder)
  5 prompt    text to paste to any Linux or Windows agent
  6 listen    COMS listen --agent <role>
  7 topics    list EVERY topic on the bus with payload sizes
  q quit
EOF
  if [[ ! -t 0 ]]; then
    return 0
  fi
  local choice
  read -r -p "> " choice
  case "$choice" in
    1|learn) cmd_learn ;;
    2|status) cmd_status ;;
    3|roster) cmd_roster ;;
    4|register) echo "run: COMS register --agent <role>" ;;
    5|prompt) cmd_prompt ;;
    6|listen) echo "run: COMS listen --agent <role>" ;;
    7|topics) cmd_topics ;;
    q|Q|"") ;;
    *) echo "unknown" ;;
  esac
}

main() {
  local cmd="${1:-menu}"
  shift || true
  case "$cmd" in
    menu|"") menu ;;
    learn|help|-h|--help) cmd_learn ;;
    status) cmd_status ;;
    roster|ls|list) cmd_roster ;;
    check|inbox|read) cmd_check "$@" ;;
    topics|list-topics|bus) cmd_topics "$@" ;;
    register) cmd_register "$@" ;;
    unregister|deregister) cmd_unregister "$@" ;;
    prompt) cmd_prompt ;;
    listen)
      local agent=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --agent) agent="${2:-}"; shift 2 ;;
          *) agent="$1"; shift ;;
        esac
      done
      cmd_listen "$agent"
      ;;
    send) cmd_send "$@" ;;
    guard) cmd_guard "$@" ;;
    *) echo "unknown command: $cmd" >&2; cmd_learn; return 2 ;;
  esac
}

main "$@"
