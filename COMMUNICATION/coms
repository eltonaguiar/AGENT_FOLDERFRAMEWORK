  COMS topics                     EVERY topic on the bus with payload sizes
  COMS topics notes/# --wait 4    just the notes, size-ordered

Examples
  inbox/gx10-c9b9/auditpage/kilo
  inbox/gx10-c9b9/auditpage-v2/kilo
  inbox/desktop-081g9oh/auditpage/claude

GitHub
  ${REPO_URL}
  protocol: README.MD section "Per-agent inbox"
  config:   COMMUNICATION/mqtt_bus.yaml
  Windows clone seen at E:\\AGENT_FOLDERFRAMEWORK
  Linux copy: ${FRAMEWORK}

Register from the agent's own folder
  Linux:   COMS register --agent kilo
  Windows: powershell -File E:\\AGENT_FOLDERFRAMEWORK\\COMMUNICATION\\coms.ps1 register -Agent claude

Roster is MQTT retained messages on registry/# plus ${LOCAL_REG}
Durable work still goes to Git. Never put secrets on the bus.
EOF
}

cmd_status() {
  echo "broker ${BROKER}:${PORT}"
  if timeout 3 bash -c "echo >/dev/tcp/${BROKER}/${PORT}" 2>/dev/null; then
    echo "tcp: open"
  else
    echo "tcp: closed"
  fi
  if command -v systemctl >/dev/null && [[ "$(host_name)" == "gx10-c9b9" || "${BROKER}" == "127.0.0.1" ]]; then
    echo "systemd: $(systemctl is-active mosquitto 2>/dev/null || echo unknown) / enabled=$(systemctl is-enabled mosquitto 2>/dev/null || echo unknown)"
  fi
  echo "--- retained status ---"
  timeout 3 mosquitto_sub -h "$BROKER" -p "$PORT" -t 'status/#' -v --retained-only -W 2 2>/dev/null || true
}

cmd_roster() {
  mkdir -p "$(dirname "$LOCAL_REG")"
  local tmp
  tmp="$(mktemp)"
  timeout 4 mosquitto_sub -h "$BROKER" -p "$PORT" -t 'registry/#' -v --retained-only -W 2 >"$tmp" 2>/dev/null || true
  python3 - "$LOCAL_REG" "$tmp" <<'PY'
import json, sys
from pathlib import Path
local, remote = Path(sys.argv[1]), Path(sys.argv[2])
rows = {}
def take(obj):
    key = obj.get("inbox") or obj.get("agent")
    if not key:
        return
    prev = rows.get(key)
    if not prev:
        rows[key] = obj
        return
    # B2 residual fix: register now omits blank fields, so merge instead of
    # replacing — a short update must not erase goal/files/commits from roster.
    merged = dict(prev)
    for k, v in obj.items():
        if v not in (None, ""):
            merged[k] = v
    if str(obj.get("registered_at", "")) > str(prev.get("registered_at", "")):
        merged["registered_at"] = obj.get("registered_at")
    rows[key] = merged
if local.is_file():
    for line in local.read_text(encoding="utf-8", errors="replace").splitlines():
        line=line.strip()
        if not line:
            continue
        try:
            take(json.loads(line))
        except json.JSONDecodeError:
            pass
if remote.is_file():
    for line in remote.read_text(encoding="utf-8", errors="replace").splitlines():
        if " " not in line:
            continue
        _topic, payload = line.split(" ", 1)
        try:
            take(json.loads(payload))
        except json.JSONDecodeError:
            pass
if not rows:
    print("no agents registered")
    sys.exit(0)
print(f"{'OS':<7} {'HOST':<18} {'WORKTREE':<18} {'AGENT':<12} PATH")
for obj in sorted(rows.values(), key=lambda o: (o.get("os",""), o.get("host",""), o.get("worktree",""), o.get("agent",""))):
    print(f"{obj.get('os','?'):<7} {obj.get('host','?'):<18} {obj.get('worktree','?'):<18} {obj.get('agent','?'):<12} {obj.get('path','')}")
    repos = obj.get("repos") or []
    if repos:
        print(f"{'':<7} repos: {', '.join(repos)}")
    print(f"{'':<7} inbox: {obj.get('inbox','')}")
    for key in ("goal", "todo", "done", "files", "commits", "prompt"):
        if obj.get(key):
            print(f"{'':<7} {key}: {obj.get(key)}")
PY
  rm -f "$tmp"
}

cmd_register() {
  local agent="" todo="" done="" goal="" files="" commits="" prompt=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="${2:-}"; shift 2 ;;
      --todo) todo="${2:-}"; shift 2 ;;
      --done) done="${2:-}"; shift 2 ;;
      --goal) goal="${2:-}"; shift 2 ;;
      --files) files="${2:-}"; shift 2 ;;
      --commits) commits="${2:-}"; shift 2 ;;
      --prompt) prompt="${2:-}"; shift 2 ;;
      *) echo "unknown arg: $1" >&2; return 2 ;;
    esac
  done
  if [[ -z "$agent" ]]; then
    echo "usage: COMS register --agent <provider-model> [--goal t] [--todo t] [--done t] [--files t] [--commits t] [--prompt t]" >&2
    return 2
  fi
  identity "$agent"
  mkdir -p "$(dirname "$LOCAL_REG")"
  local repos json
  repos="$(repo_urls)"
  json="$(python3 - "$AGENT" "$HOST" "$WT" "$INBOX" "$SBUS" "$PATH_NOW" "$repos" "$todo" "$done" "$goal" "$files" "$commits" "$prompt" <<'PY'
import json, sys, datetime
agent, host, wt, inbox, sbus, path, repos, todo, done, goal, files, commits, prompt = sys.argv[1:14]
obj = {
  "agent": agent,
  "host": host,
  "os": "linux",
  "worktree": wt,
  "path": path,
  "inbox": inbox,
  "swarmbus_id": sbus,
  "repos": [r for r in repos.split(",") if r],
  "registered_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}
# B2: only emit a key when its flag was supplied. Emitting all seven keys with
# empty strings made a short status update silently erase goal/files/commits.
for k, v in (("goal", goal), ("todo", todo), ("done", done), ("files", files), ("commits", commits), ("prompt", prompt)):
    if v:
        obj[k] = v
print(json.dumps(obj))
PY
)"
  printf '%s' "$json" | refuse_secrets || return 2
  # B6: the broker does not enforce unique seats. Warn loudly when this inbox is
  # already taken so two agents do not silently share one wake topic.
  local prior
  prior="$(timeout 3 mosquitto_sub -h "$BROKER" -p "$PORT" -t "registry/${HOST}/${WT}/${AGENT}" --retained-only -W 2 2>/dev/null | head -n1)"
  if [[ -n "$prior" ]]; then
    echo "warning: ${INBOX} is already registered (duplicate seat); use a session suffix or COMS unregister --agent ${AGENT}" >&2
  fi
  # B4: append-only grew the roster to 103 rows / 35 distinct seats, so every
  # "who is alive" answer was ambiguous. Upsert by swarmbus_id instead.
  python3 - "$LOCAL_REG" "$json" <<'PY'
import json, pathlib, sys
p, raw = pathlib.Path(sys.argv[1]), sys.argv[2]
new = json.loads(raw)
rows, out, found = [], [], False
if p.is_file():
    for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except Exception:
            continue
for r in rows:
    if r.get("swarmbus_id") == new.get("swarmbus_id"):
        merged = dict(r); merged.update({k: v for k, v in new.items() if v})
        out.append(merged); found = True
    else:
        out.append(r)
if not found:
    out.append(new)
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text("\n".join(json.dumps(r, separators=(",", ":")) for r in out) + "\n", encoding="utf-8")
print("roster rows=%d" % len(out))
PY
  mosquitto_pub -h "$BROKER" -p "$PORT" -t "registry/${HOST}/${WT}/${AGENT}" -r -m "$json"
  echo "registered ${INBOX}"
  echo "$json"
}

